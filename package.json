  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3002",
    "build": "next build --webpack",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
